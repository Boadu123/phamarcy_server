# PostgreSQL container settings
POSTGRES_DB=pharmacy_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Spring Boot API settings
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database connection pool settings used by the app container
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# Logging
ROOT_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
